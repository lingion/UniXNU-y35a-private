@@ -88,10 +88,13 @@
 extern uint64_t native_early_fault_address;
-static void native_phase_marker(uint32_t slot, uint64_t value)
+static boot_args *native_phase_args;
+static void native_phase_marker(boot_args *args, uint32_t slot, uint64_t value)
 {
 	volatile uint64_t *record;
-	if (native_early_fault_address == 0) return;
-	/* start.s publishes the retained args+0x800 carrier before C starts. */
-	record = (volatile uint64_t *)(uintptr_t)native_early_fault_address;
+	if (native_phase_args == 0) native_phase_args = args;
+	/* arm_init receives the original boot_args as a valid KVA after MMU enable. */
+	record = (volatile uint64_t *)((uintptr_t)native_phase_args + 0x800);
 	if (slot >= 11) return;
 	record[slot] = value;
+	/* Preserve the marker in RAM for the retained-memory readback probe. */
+	__asm__ volatile("dc civac, %0\n\tdsb sy" : : "r"(&record[slot]) : "memory");
 }
