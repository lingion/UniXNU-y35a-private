+boolean_t
+IOY35ARequestEmmcRootFallback(void)
+{
+	if (!native_y35a_tf_root_selected) {
+		return FALSE;
+	}
+	if (native_y35a_emmc_fallback_active) {
+		panic("Y35A eMMC root failed after the single fallback attempt\n");
+	}
+	if (!PE_parse_boot_argn("emmc-boot-uuid", native_y35a_emmc_uuid, kMaxBootVar)) {
+		panic("Y35A TF root failed without emmc-boot-uuid\n");
+	}
+	native_y35a_emmc_fallback_active = TRUE;
+	return TRUE;
+}
