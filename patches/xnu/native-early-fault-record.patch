--- a/osfmk/arm64/locore.s
+++ b/osfmk/arm64/locore.s
@@ -316,6 +316,25 @@
 Lel1_sp0_synchronous_vector_long:
 	sub		sp, sp, ARM_CONTEXT_SIZE			// Make space on the exception stack
 	stp		x0, x1, [sp, SS64_X0]				// Save x0, x1 to the stack
+#if defined(XNU_NATIVE_EARLY_FAULT) && XNU_NATIVE_EARLY_FAULT
+	// Retain the first pre-thread exception before C panic handling.
+	adrp		x0, EXT(native_early_fault_address)@page
+	add		x0, x0, EXT(native_early_fault_address)@pageoff
+	ldr		x0, [x0]
+	cbz		x0, Lnative_fault_recorded
+	ldr		x1, [x0]
+	cbnz		x1, Lnative_fault_recorded
+	mov		x1, #1
+	str		x1, [x0]
+	mrs		x1, ELR_EL1
+	str		x1, [x0, #8]
+	mrs		x1, ESR_EL1
+	str		x1, [x0, #16]
+	mrs		x1, FAR_EL1
+	str		x1, [x0, #24]
+	dsb		sy
+Lnative_fault_recorded:
+#endif
 	mrs		x1, ESR_EL1							// Get the exception syndrome
 	/* If the stack pointer is corrupt, it will manifest either as a data abort
 	 * (syndrome 0x25) or a misaligned pointer (syndrome 0x26). We can check
@@ -1113,3 +1134,11 @@
 //#include	"globals_asm.h"

 /* vim: set ts=4: */
+#if defined(XNU_NATIVE_EARLY_FAULT) && XNU_NATIVE_EARLY_FAULT
+.data
+.balign 8
+.global EXT(native_early_fault_address)
+LEXT(native_early_fault_address)
+.quad 0
+#endif
