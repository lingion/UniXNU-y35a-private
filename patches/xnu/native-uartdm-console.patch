diff --git a/pexpert/pexpert/arm/uartdm.h b/pexpert/pexpert/arm/uartdm.h
new file mode 100644
--- /dev/null
+++ b/pexpert/pexpert/arm/uartdm.h
@@ -0,0 +1,89 @@
+/* Polled legacy-mode UARTDM v1.4 (BLSP), retaining bootloader configuration.
+ * Register/protocol reference: LK2nd 23.1 platform/msm_shared/uart_dm.{c,h}.
+ * No clocks, pinctrl, baud, interrupts, DMA, or RX transfer ownership here.
+ */
+#ifndef _PEXPERT_ARM_UARTDM_H
+#define _PEXPERT_ARM_UARTDM_H
+
+#ifndef UARTDM_READ32
+#define UARTDM_READ32(base, off) (*(volatile uint32_t *)((base) + (off)))
+#endif
+#ifndef UARTDM_WRITE32
+#define UARTDM_WRITE32(base, off, value) (*(volatile uint32_t *)((base) + (off)) = (value))
+#endif
+#define UARTDM_SR 0xa4u
+#define UARTDM_CR 0xa8u
+#define UARTDM_ISR 0xb4u
+#define UARTDM_TF 0x100u
+#define UARTDM_DMEN 0x3cu
+#define UARTDM_NCF_TX 0x40u
+#define UARTDM_RXRDY 1u
+#define UARTDM_TXRDY 4u
+#define UARTDM_TXEMT 8u
+#define UARTDM_TX_READY 0x80u
+#define UARTDM_RESET_TX_READY 0x300u
+#define UARTDM_POLL_LIMIT 100000u
+
+/* ADT compatible is a bounded NUL-separated string list, not a prefix. Only
+ * v1.4 is supported: older GSBI DM uses SR=0x08, CR=0x10, TF=0x70. */
+static inline int
+uartdm_compatible(const char *list, unsigned length)
+{
+	static const char wanted[] = "qcom,msm-uartdm-v1.4";
+	if (!list) return 0;
+	for (unsigned start = 0; start < length;) {
+		unsigned end = start;
+		while (end < length && list[end]) ++end;
+		if (end == length) return 0;
+		if (end - start == sizeof(wanted) - 1) {
+			unsigned i = 0;
+			while (i < sizeof(wanted) - 1 && list[start + i] == wanted[i]) ++i;
+			if (i == sizeof(wanted) - 1) return 1;
+		}
+		start = end + 1;
+	}
+	return 0;
+}
+
+/* A read budget, not a timer frequency assumption; zero means no MMIO. */
+static inline int
+uartdm_wait(uintptr_t base, uint32_t mask, unsigned budget)
+{
+	while (budget--) if (UARTDM_READ32(base, UARTDM_SR) & mask) return 1;
+	return 0;
+}
+static inline int
+uartdm_drain(uintptr_t base, unsigned budget)
+{
+	return uartdm_wait(base, UARTDM_TXEMT, budget);
+}
+static inline int
+uartdm_rx_available(uintptr_t base)
+{
+	return !!(UARTDM_READ32(base, UARTDM_SR) & UARTDM_RXRDY);
+}
+
+/* At most one FIFO word. XNU's console serializes callers and owns CRLF.
+ * Wait for the preceding transaction BEFORE NCF_TX; never reset the UART to
+ * recover a timeout. A stuck or DMA-owned UART drops output rather than hangs. */
+static inline int
+uartdm_write_word(uintptr_t base, const uint8_t *bytes, unsigned count, unsigned budget)
+{
+	if (!bytes || !count || count > 4 || !budget) return 0;
+	if (UARTDM_READ32(base, UARTDM_DMEN)) return 0;
+	unsigned left = budget;
+	while (left--) {
+		if ((UARTDM_READ32(base, UARTDM_SR) & UARTDM_TXEMT) ||
+		    (UARTDM_READ32(base, UARTDM_ISR) & UARTDM_TX_READY)) goto ready;
+	}
+	return 0;
+ready:
+	UARTDM_WRITE32(base, UARTDM_NCF_TX, count);
+	UARTDM_WRITE32(base, UARTDM_CR, UARTDM_RESET_TX_READY);
+	if (!uartdm_wait(base, UARTDM_TXRDY, budget)) return 0;
+	uint32_t word = 0;
+	for (unsigned i = 0; i < count; ++i) word |= (uint32_t)bytes[i] << (i * 8);
+	UARTDM_WRITE32(base, UARTDM_TF, word);
+	return 1;
+}
+#endif /* _PEXPERT_ARM_UARTDM_H */
