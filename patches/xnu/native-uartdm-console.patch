+/* Return true once v1.4 is selected, even when its resources are invalid:
+ * never let the legacy name-only PL011 path touch a selected UARTDM. ADT reg
+ * uses native uintptr_t offset/size pairs relative to arm-io's SoC base. */
+static bool
+uartdm_probe(vm_offset_t soc_base)
+{
+	DTEntry entry = NULL;
+	const char *compatible = NULL;
+	const uintptr_t *reg = NULL;
+	uint32_t size = 0;
+	if (SecureDTFindEntry("boot-console", NULL, &entry) != kSuccess &&
+	    SecureDTFindEntry("name", "uart0", &entry) != kSuccess &&
+	    SecureDTFindEntry("name", "uart1", &entry) != kSuccess) return false;
+	if (SecureDTGetProperty(entry, "compatible", (const void **)&compatible, &size) != kSuccess ||
+	    !uartdm_compatible(compatible, size)) return false;
+	if (SecureDTGetProperty(entry, "reg", (const void **)&reg, &size) == kSuccess &&
+	    size == 2 * sizeof(*reg) && !(reg[0] & 3) && reg[1] >= UARTDM_TF + 4 &&
+	    reg[0] <= ~(uintptr_t)0 - soc_base &&
+	    reg[1] <= ~(uintptr_t)0 - (soc_base + reg[0])) {
+		uartdm_base = ml_io_map(soc_base + reg[0], reg[1]);
+	}
+	return true;
+}
+#endif /* XNU_NATIVE_UARTDM */
