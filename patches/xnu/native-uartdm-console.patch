+static unsigned int uartdm_transmit_ready(void) { return 1; }
+static void uartdm_transmit_data(uint8_t c)
+{
+	(void)uartdm_write_word(uartdm_base, &c, 1, UARTDM_POLL_LIMIT);
+}
+/* TX-only console. RXRDY alone does not establish a valid byte count; do not
+ * expose padded FIFO bytes without implementing DMRX/stale/snapshot lifecycle. */
+static unsigned int uartdm_receive_ready(void) { return 0; }
+static uint8_t uartdm_receive_data(void) { return 0; }
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) uartdm_serial_functions = {
+	.init = uartdm_init,
+	.transmit_ready = uartdm_transmit_ready,
+	.transmit_data = uartdm_transmit_data,
+	.receive_ready = uartdm_receive_ready,
+	.receive_data = uartdm_receive_data,
+	.device = SERIAL_UARTDM
